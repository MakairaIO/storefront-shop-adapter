{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "lint:eslint": { "outputs": ["src/**"] },
    "lint:tsc": { "outputs": [] },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "clean": { "outputs": ["dist/**"], "dependsOn": [] },
    "@makaira/storefront-types#build": {
      "outputs": ["dist/**"],
      "dependsOn": ["clean"]
    },
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["@makaira/storefront-types#build", "clean"]
    },
    "release": {
      "outputs": ["package.json"],
      "dependsOn": ["build"]
    }
  }
}
